# Copy to .env (or export in your shell). Ollama must be running: `ollama serve`.

# Ollama connection (used by every service via shared/ollama.js)
OLLAMA_HOST=http://localhost:11434
# Only qwen2.5-coder-16k is pulled by default. A general instruct model reasons
# about bias far better — recommended: `ollama pull qwen2.5:7b-instruct`
OLLAMA_MODEL=qwen2.5-coder-16k:latest

# Ports
PORT=5050            # orchestrator (5000 is taken by macOS AirPlay Receiver)
# omission :5001  framing :5002  fear :5003 (defaults baked into each service)

# Redis cache (optional — services run fine without it, just uncached)
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=86400

# Orchestrator → detector service URLs (override if running on other hosts)
OMISSION_URL=http://localhost:5001/analyze
FRAMING_URL=http://localhost:5002/analyze
FEAR_URL=http://localhost:5003/analyze
